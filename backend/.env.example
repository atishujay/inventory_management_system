# Copy this file to .env and fill in your own values.
#
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
#
# Use host "db" when running through docker compose (it is the service name),
# or "localhost" when running uvicorn directly against a local PostgreSQL install.
DATABASE_URL=postgresql://postgres:your_password_here@db:5432/inventory_db
